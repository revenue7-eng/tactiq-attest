# Test fixtures are raw TPM output (signatures, TPMS_ATTEST, TPM2B_PUBLIC).
# Some contain 0x0a and no NUL, so git would guess "text" and an
# autocrlf checkout would rewrite them, breaking real TPM signatures.
crates/attest-appraise/tests/fixtures/** binary
# Registrar fixtures: certificates, a key, TPM names and credential blobs.
tools/registrar/tests/fixtures/**/*.der binary
tools/registrar/tests/fixtures/**/*.pk8 binary
tools/registrar/tests/fixtures/**/*.bin binary
tools/registrar/tests/fixtures/**/*.blob binary
# Signature fixtures: a signature covers the record bytes exactly, so neither
# the .p7s files nor the signed .json may be rewritten on checkout.
tools/registrar/tests/fixtures/signature/** binary
tools/registrar/tests/fixtures/**/*.crl binary
# Release fixtures of the stop service: release.sig covers the exact bytes of
# release, so neither may be rewritten on checkout.
crates/stop/testdata/release binary
crates/stop/testdata/release.sig binary
# Stop receipts and keys from swtpm: TPM signatures over exact bytes.
crates/attest-appraise/tests/fixtures/stop/*.tqsr binary
crates/attest-appraise/tests/fixtures/stop/*.pub binary
# The stop sample: a TPM-signed receipt over exact bytes.
docs/stop-sample/*.tqsr binary
